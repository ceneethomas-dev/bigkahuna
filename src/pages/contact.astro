---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config.js';

const fullAddress = `${siteConfig.address.street}, ${siteConfig.address.postalCode} ${siteConfig.address.city}`;
const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
---

<Layout
	title={`Contact - ${siteConfig.name}`}
	description={`Contactez ${siteConfig.name} : adresse, téléphone, horaires d'ouverture.`}
>
	<h1>Contactez-nous</h1>

	<section>
		<h2>Adresse</h2>
		<p>
			<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
				{siteConfig.address.street}<br />
				{siteConfig.address.postalCode} {siteConfig.address.city}
			</a>
		</p>
	</section>

	<section>
		<h2>Téléphone</h2>
		<p><a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a></p>
	</section>

	<section>
	<h2>Horaires</h2>
	<ul>
		{siteConfig.openingHours.map((day) => (
			<li>
				<strong>{day.label}</strong> :
				{day.closed
					? " Fermé"
					: day.slots?.map((slot) => `${slot.opens} - ${slot.closes}`).join(" / ")}
			</li>
		))}
	</ul>
</section>

	<section>
		<h2>Suivez-nous</h2>
		<p>
			<a href={siteConfig.social.facebook} target="_blank">Facebook</a>
			·
			<a href={siteConfig.social.instagram} target="_blank">Instagram</a>
		</p>
	</section>
</Layout>